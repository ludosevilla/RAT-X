nat lastPlMapY;

/////////////////////////////////////////
//// APP FUNCTIONS
////////////////////////////////////////

// Set element on the tile map
void setElements(byte typ) {
byte x;
byte y;
byte c;
byte n;
byte sp;
nat a;
byte i=0;

	if (typ==0) { // Cats
		n=numCats;
		sp=27;
	} else if (typ==1) { // Cheese
		n=numCheese;
	} else if (typ==2) { // Dollar
		n=numDollar;
		sp=23;
	} else if (typ==3) { // rocks
		n=numRock;
		sp=22;
	} else return;

	while(i<n) {
		x=rnd(1,30);
		y=rnd(1,54);
		if ((typ==0 || typ==3) && (x==15 && y>=44 && y<=68))
			continue;
		a=(nat)(_tsMapAddr+(yoffs+y)*64+xoffs+x);
		c = peek(a,_tsMapPage);
		if (c!=0)
			continue;
		if (typ==1) {
			sp = rnd(20,26);
			if (sp<24) sp=24;
		}
		poke(a,sp,_tsMapPage);
		i++;
	}
}

// "Star Screen" functions

type tStar {
	int X;
	int Y;
	nat time;
};

tStar stars[10];
byte numStars;

void starInit() {
	numStars=0;
	for(byte i=0;i<10;i++)
		stars[i].X=-1;
}

void starPut() {
	nat a;
	byte i;
	if (numStars==10) return;
	for(i=0;i<10;i++) {
		if (stars[i].X==-1) {
			stars[i].X=_tsTileOffsetX;
			stars[i].Y=_tsTileOffsetY;
			stars[i].time=_time+rnd(10,15);
			numStars++;
			a=(nat)(_tsMapAddr+(_tsTileOffsetY+4)*64+_tsTileOffsetX+7);	
			poke(a,28,_tsMapPage);
			_tsUpdate=true;
			return;
		}
	}
}

bool starLoop() {
	byte i;
	nat a;
	for(i=0;i<10;i++) {
		if (stars[i].X!=-1 && stars[i].time<_time) {
			numStars--;
			a=(nat)(_tsMapAddr+(stars[i].Y+4)*64+stars[i].X+7);	
			poke(a,0,_tsMapPage);
			_tsUpdate=true;
			stars[i].X=-1;
			return true;
		}
	}
	return false;
}




// "Radar" map functions

