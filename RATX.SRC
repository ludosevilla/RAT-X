void main() {
byte lastMove;
byte lastMoveOk;
byte cptMove;
byte c;
byte tick;
bool stop;
bool noStar;
nat n;

	import("/system/reginit.dat",0x1100,0);
	poke(gfxModes,0); 
	vCount(1);

	clearSprites();
	clearTiles();
	clearTileSet();
	clearBitMap();

	byte oldR=peek(0x2f13);
	byte oldG=peek(0x2f14);
	byte oldB=peek(0x2f15);
	poke(0x2f13,0);
	poke(0x2f14,0);
	poke(0x2f15,0);
	poke(statusReg,peek(0x2f0b)&0b01111111); 

	cls();
	poke(gfxModes,0b00010000);
	curPos(0,0);
	print("2CHARSET REDEFINITION. Please wait...");


	importFont("res/C64.FNT",0,60,0x20);
	importFont("res/C64.FNT",61,26,0x61);


	cls();
	poke(gfxModes,0);

	import("res/spr.spr",cpuWindow,5120,sprPage);
	import("res/spr.pla",sprPlaA,48);
	

	noMusic=false;
	
	while(true) {
		/////////////////////////
		////// Main Loop
		/////////////////////////

		// New Game -  Display the title screen
		
		poke(gfxModes,0); 
		cls();
		ymNoteOff(0);
		ymNoteOff(1);
		synNoteOff(0);
		synNoteOff(1);
		_snd_setupSound();
		_snd_bar=_snd_song[0];
		
		import("res/ratxacc.bmp",cpuWindow,48000,bmpPageA);
		import("res/ratxacc.pal",0x11a0,48);

		curPos(11,8);
		print("2Based on the game 'Radar Rat Race' (1982) for Commodore 64");
		curPos(12,38);
		print("7Jean-arthur Silve - Music by Benoit Saint-Moulin - 2026");
		curPos(28,39);
		print("bPress Fire(A) to start!");
		poke(gfxModes,0b00010001);
		
		
		while((_padLft & 0b00000001)==0) {if(_keyDwn==12) break;}
		if(_keyDwn==12) break;
		
		poke(gfxModes,0); 

		score=0;
		lives=5;
		level=1;

		// Display the game's background image.
		// Only colors 7 through 15 can be displayed over the tiles
		import("res/ratxbg2.bmp",cpuWindow,48000,bmpPageA);
		import("res/ratxbg2.pal",0x11a0,48);
		
		while(true) {
			// New level
			poke(gfxModes,0); 
			cls();
			curPos(25,38);
			print("b P 2Pause ");
			curPos(25,39);
			print("b S 2Sound on/off ");

			_snd_onoff(false);
			
			nextPoints=100;		
			lastPlMapX=10000;
						
			initLevel();
			timer=_time+playTime;
			starInit();
			
			// Initialize scrolling functions
			// LVL file has been made with MAPED tool
			tsInit(15,13,2,1,"RES/LABYTILE","RES/LABYTILE.LVL",cpuWindow,0x8f);
			setElements(0);
			setElements(1);
			setElements(2);
			setElements(3);

			// Display the map with an offset
			tsDisplay(23,73);	
			mapDrawRadar();
			ratsStart();

			poke(gfxModes,0b10011101); //enable sprites tiles and text

			initPlayer();
			mapShowPlayer();

			cptMove=0;
			lastMove=255;
			lastMoveOk=255;
			noMove=255;

			noStar=false;
			numCheeseCatch=0;
			tick=0;
			
			stop=false;
			_snd_onoff(true);
			ratsLoop();
			displayInfo();
			sprUpdt();
			showMessageLevel();
			
			while(!stop) {
								
				_snd_play();	// Should be called as often as possible
								
				if (noStar && _mSec>200)
					noStar=false;
				
				if (tick==0) {
					displayInfo();
					n = reverseChase-_time;
					// LED blinking, for fun!
					if (n==0 || n==4 || n==2) {
						poke(0x117e,4);
						poke(0x118e,0);
						poke(0x119e,0);
						poke(0x117c,7);
						poke(0x118c,4);
						poke(0x119c,0);
						led(255,255,255);
					} else if (n==1 || n==3 || n==5) {
						poke(0x117e,0);
						poke(0x118e,0);
						poke(0x119e,0);
						poke(0x117c,5);
						poke(0x118c,1);
						poke(0x119c,7);
						led(255,0,255);
					}
					starLoop();
				}
				tick++;
				if (tick==10) tick=0;
			
				ratsLoop();
						
				if (_keyDwn==12) break; // Exit program?
				if (_keyDwn==32) {		// Disable sound?
					noMusic=!noMusic;
					_snd_onoff(!noMusic);
					sleep(300);
				}

				pause(); // Pause?
				
				if (cptMove>0) { // Player is still moving from a tile to another (in fact, map is scrolling, sprite player is pot moving)
					tsScroll(lastMove,playerSpeed);
					cptMove--;
					if (cptMove==0) // The move is over
						mapShowPlayer();
				} else {		
					if (_padLft & 0b00000001 && noStar==false) { // Fire A:star screen
						clkSet();
						noStar=true;
						starPut();
						timer-=5;
						if(timer<0) timer=0;
					}
					
					lastMove=255;
					c=255;
					if (noMove!=255 && lastMoveOk!=255) {
						//If player turns before reaching the corner,
						//continue moving in the previous direction (once)
						if (lastMoveOk==0 && (noMove==1 || noMove==3)) {
							c=0;
						} else if (lastMoveOk==1 && (noMove==0 || noMove==2)) {
							c=1;
						} else if (lastMoveOk==2 && (noMove==1 || noMove==3)) {
							c=2;
						} else if (lastMoveOk==3 && (noMove==2 || noMove==0)) {
							c=3;
						}
						lastMoveOk=255;
					}
					
					if (c==255) 
						c=getPadDirection(_padLft);
					
					if (noMove!=1 && c==1 ) { // Right
						lastMove=1;
						sprRef(31,1);
						sprFlip(31,false,false);
					} else if (noMove!=3 && c==3) { // Left
						lastMove=3;
						sprRef(31,1);
						sprFlip(31,true,false);
					} else if (noMove!=2 && c==2) { // Down
						lastMove=2;
						sprRef(31,0);
						sprFlip(31,false,true);
					} else if (noMove!=0 && c==0) { // Up
						lastMove=0;
						sprRef(31,0);
						sprFlip(31,false,false);
					}

					if (lastMove!=255) {
						noMove=255;
						cptMove=32/playerSpeed;
					}
				}
					
				vSync();
				// Do the buuffer swap and change tile offset
				// Even when performed immediately after vSync, it's still not perfect.
				tsVSync(); 
				sprUpdt();

				// Better for speed perforance than a loop
				if (isSprTile(31,1,false) ||
				isSprTile(31,2,false) ||
				isSprTile(31,3,false) ||
				isSprTile(31,4,false) ||
				isSprTile(31,5,false) ||
				isSprTile(31,6,false) ||
				isSprTile(31,7,false) ||
				isSprTile(31,8,false) ||
				isSprTile(31,9,false) ||
				isSprTile(31,10,false) ||
				isSprTile(31,11,false) ||
				isSprTile(31,12,false) ||
				isSprTile(31,13,false) ||
				isSprTile(31,14,false) ||
				isSprTile(31,15,false) ||
				isSprTile(31,16,false) ||
				isSprTile(31,17,false) ||
				isSprTile(31,18,false) ||
				isSprTile(31,19,false) ||
				isSprTile(31,20,false) ||
				isSprTile(31,21,false) ||
				isSprTile(31,22,false) ) {

					// Player touch a wall or border:reverse scrolling
					noMove=lastMove; // We record this move to not repeat it right now
					if (lastMove==1) lastMove=3;
					else if (lastMove==3) lastMove=1;
					else if (lastMove==2) lastMove=0;
					else if (lastMove==0) lastMove=2;
					tsScroll(lastMove,playerSpeed);
					tsVSync();
					cptMove=0;
				} else {
					lastMoveOk=lastMove;
					c=sprOther(31,0);
					if (c<=7) { // Rat
						if (reverseChase<_time) {	
							// Rat caught the player
							lives--;
							sprRef(31,7);
							sprFlip(31,false,false);
							sprUpdt();
							soundBeep(2);							
							sleep(1000);
							sprRef(31,0);
							
							if (lives==0 || willMove==false) // Bonus stage:don't play it again
								stop=true;
							else {
								timer=_time+playTime;
								tsDisplay(23,73);
								ratsStart();
								initPlayer();
								mapShowPlayer();
								ratsLoop();
								sprUpdt();
								showMessageLevel();
							}
							tsVSync();
						} else {
							// Player had caught a bonus and can "eat" the rat
							soundBeep(1);
							score+=500;
							sprRef(c,4);
							sprUpdt();
							showPoints(500,500);
							sprRef(c,2);
							ratsSetMapPos(c,13,54,willMove);
							sprPos(c,0,0);
						}
					} else if (isSprTile(31,23,false)) { // Dollar
						if (cptMove==0) {
							soundBeep(0);
							score+=1000;
							showPoints(1000,500);
							reverseChase=_time+bonusTime;
							poke(0x117e,7);
							poke(0x118e,7);
							poke(0x119e,7);
							poke(0x117c,5);
							poke(0x118c,1);
							poke(0x119c,7);
							clearPlayerTile();
							mapRemove(_tsTileOffsetX-8,_tsTileOffsetY-24);			
							led(255,0,255);
							tsVSync();
						}
					} else if (isSprTile(31,24,false)) { // Cheese
						if (cptMove==0) {
							soundBeep(0);
							numCheeseCatch++;
							score+=nextPoints;
							showPoints(nextPoints,500);
							nextPoints+=100;
							clearPlayerTile();
							mapRemove(_tsTileOffsetX-8,_tsTileOffsetY-24);
							tsVSync();
							
						}
					} else if (isSprTile(31,25,false)) { // Cheese X2
						if (cptMove==0) {	
							soundBeep(0);
							numCheeseCatch++;
							score+=nextPoints*2;
							showPoints(nextPoints*2,500);
							nextPoints+=100;
							clearPlayerTile();
							mapRemove(_tsTileOffsetX-8,_tsTileOffsetY-24);		
							tsVSync();
						}
					} else if (isSprTile(31,26,false)) { // Cheese X4
						if (cptMove==0) {				
							soundBeep(0);
							numCheeseCatch++;
							score+=nextPoints*4;
							showPoints(nextPoints*4,500);
							clearPlayerTile();
							mapRemove(_tsTileOffsetX-8,_tsTileOffsetY-24);
							tsVSync();
						}
					} else if (timer<=_time || isSprTile(31,27,false)) { // Cat
						if (cptMove==0) {				
							lives--;
							sprRef(31,7);
							sprFlip(31,false,false);
							sprUpdt();
							soundBeep(2);
							sleep(1500);
							sprRef(31,0);
							if (lives==0 || willMove==false) // Bonus stage:don't play it again
								stop=true;
							else {
								timer=_time+playTime;
								tsDisplay(23,73);
								ratsStart();
								initPlayer();
								mapShowPlayer();
								ratsLoop();
								sprUpdt();
								showMessageLevel();
							}
							tsVSync();
						}
					}
					if (numCheeseCatch==numCheese) {	
						// All cheeses grabbed
						stop=true;
					}
				}
			}
			if (lives==0) break;
			
			// Next level
			level++;
			if (_keyDwn==12) break;		
		}
		if (_keyDwn==12) break;		
	}
	// Exiting

	clearSprites();
	clearBitMap();	
	cls();

	ymNoteOff(0);
	ymNoteOff(1);
	synNoteOff(0);
	synNoteOff(1);
			
	import("/system/reginit.dat",0x1100,0);
	
	poke(0x2f13,oldR);
	poke(0x2f14,oldG);
	poke(0x2f15,oldB);
	print("d                  e6e7e8e9eaebec93eeef");
	print("1Thanks for using  df6f7f8f9fafbfcfdfeff 1computer!");
	
	led(255,255,255);
	poke(gfxModes,0b00010000); //enable text
}

// Run the game
main();
