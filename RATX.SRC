		ratSpeed=2;
		playerSpeed=4;
		willMove=false; // Bonus stage when willMoce is false
		drawMap=false;
		showCats=false;
		showCheese=true;
		return;
	} else if (level==4) {
		playTime=120;
		bonusTime=20;		
