		numRock=5;
		numDollar=2;
		numRats=5;
		ratSpeed=2;
		playerSpeed=4;
		willMove=true;
		drawMap=false;
		showCats=false;
		showCheese=true;
		return;
	} else if (level==5) {
		playTime=120;
		bonusTime=15;
		numCats=5;
		numCheese=7;
		numRock=8;
		numDollar=2;
