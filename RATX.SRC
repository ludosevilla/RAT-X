	int X; // "raw" X sprite positon when map is at top left
	int Y; // "raw" Y sprite position when map is at top left
	int moveCnt;
	byte noDir;
	bool willMove;
	nat lastRadarX;
	nat lastRadarY;
	byte lastRadarColor;
	nat starRotate;
	byte starStep;
};

// Max 8 rats (in fact 5 is a max)
tRats rats[8];

// Draw on the radar map, cats and cheeses
// Rocks are never shown
void mapDrawRadar() {
byte x;
byte y;

byte c;

	box(300+10,120-25,363+10,231-25,8);
	for(y=0;y<56;y++) {
		for(x=0;x<32;x++) {
			c = peek((nat)(_tsMapAddr+(yoffs+y)*64+xoffs+x),_tsMapPage);
			if (drawMap && (c>=1 && c<=16)) {
				box(310+(x*2),95+(y*2),311+(x*2),96+(y*2),10);
			} else if (showCats && c==27) {
				box(310+(x*2),95+(y*2),311+(x*2),96+(y*2),13);
			} else if (showCheese && c>=24 && c<=26) {
				box(310+(x*2),95+(y*2),311+(x*2),96+(y*2),15);
			}

		}
	}
}


// Get the picel color to use on the radar
// according to what is on this place(x,y)
byte mapGetColor(int x,int y) {
// 0<=x<32
// 0<=y<56
byte c;
byte color;
	
	if (x==13+(_tsTileOffsetX-23) && y==49+(_tsTileOffsetY-73)) // Joueur
		return 14;
	
	for (byte id=0;id<8;id++) {
		if (rats[id].mapX==x && rats[id].mapY==y) // rat
			return 11;
	}
	
	c = peek((nat)(_tsMapAddr+(yoffs+y)*64+xoffs+x),_tsMapPage);
	if (drawMap && c>=1 && c<=16) {
		return 10;
	} else if (showCheese && c>=24 && c<=26) { // cheese
		return 15;
	} else if (showCats && c==27) { // Cat
		return 13;
	}
	return 8;
}


void mapRemove(nat x,nat y) {
byte c;
	c=mapGetColor(x,y);
	box(x,y,x+1,y+1,c);
}

void mapShowPlayer() {
byte c;
	int x;
	int y;
	
	x=310+(_tsTileOffsetX-8)*2;
	y=95+(_tsTileOffsetY-24)*2;

	if (lastPlMapX!=10000) {
		c=mapGetColor(lastPlMapX-8,lastPlMapY-24);
		box(310+(lastPlMapX-8)*2,95+(lastPlMapY-24)*2,311+(lastPlMapX-8)*2,96+(lastPlMapY-24)*2,c);
	}
	box(x,y,x+1,y+1,14);
	lastPlMapX=_tsTileOffsetX;
	lastPlMapY=_tsTileOffsetY;
}

void mapRemoveRat(byte id) {
byte c;
nat x;
nat y;
	if (rats[id].mapX!=-1) {
		x=310+((nat)rats[id].mapX)*2;
		y=95+((nat)rats[id].mapY)*2;
		rats[id].mapX=-1;
		mapRemove(x,y);
	}
}

void mapShowRat(byte id) {
byte c;
nat x;
nat y;
	x=310+((nat)rats[id].mapX)*2;
	y=95+((nat)rats[id].mapY)*2;

	if (rats[id].lastRadarX!=10000) {
		c=mapGetColor(rats[id].lastRadarX,rats[id].lastRadarY);
		box(310+(rats[id].lastRadarX)*2,95+(rats[id].lastRadarY)*2,311+(rats[id].lastRadarX)*2,96+(rats[id].lastRadarY)*2,c);
	}

	box(x,y,x+1,y+1,11);
	rats[id].lastRadarX=(nat)rats[id].mapX;
	rats[id].lastRadarY=(nat)rats[id].mapY;
}



// Rats functions


void ratsInit() {
	for(byte i=0;i<8;i++) {
		rats[i].sprId=i;
		rats[i].mapX=-1;
		rats[i].moveCnt=0;
		rats[i].X=-1;
		rats[i].willMove=true;		
		rats[i].lastRadarX=10000;
		rats[i].starRotate=0;

		sprRef(i,2);
		sprFlip(i,false,false);
		sprPos(i,0,0);
	}
}


void _ratsDisplay() {
	int ofsMapX;
	int ofsMapY;
	int posX;
	int posY;

	int pixelXOfs;
	int pixelYOfs;
	
	ofsMapX = _tsTileOffsetX-8;
	ofsMapY = _tsTileOffsetY-24;

	pixelXOfs = (ofsMapX*32)-48+6+(int)peek(tilXOffset);
	pixelYOfs = (ofsMapY*32)-42+6+(int)peek(tilYOffset);
	
	for(byte id;id<8;id++) {
		if (rats[id].X!=-1) {
			posX = rats[id].X - pixelXOfs;
			posY = rats[id].Y - pixelYOfs;

			if (posX>=0 && posX<=900 && posY>=0 && posY<=600)
				sprPos(rats[id].sprId,posX,posY);
		}
	}
	
}

void ratsSetMapPos(byte id,int x,int y,bool willMove) {
	int ofsMapX;
	int ofsMapY;
	int posX;
	int posY;
	
	rats[id].mapX=x;
	rats[id].mapY=y;
	rats[id].willMove=willMove;

	posX = ((x+9)*32);
	posY = ((y+5)*32);
	
	rats[id].X=posX;
	rats[id].Y=posY;

	ofsMapX = _tsTileOffsetX-8;
	ofsMapY = _tsTileOffsetY-24;
	
	posX = posX - (ofsMapX*32)+48-6;
	posY = posY - (ofsMapY*32)+42-6;

	rats[id].moveCnt=0;
	rats[id].noDir=255;
	rats[id].starRotate=0;

	mapShowRat(id);
}

void ratsResetPos() {
	for(byte i=0;i<8;i++) {
		if (rats[i].mapX!=-1)
			ratsSetMapPos(i,rats[i].mapX,rats[i].mapY,rats[i].willMove);
		sprPos(rats[i].sprId,0,0);
	}
}

void ratsMove(byte id,byte dir) {
	byte c;
	if (rats[id].moveCnt!=0) return;

	mapShowRat(id);
	
	rats[id].nextMapX=rats[id].mapX;
	rats[id].nextMapY=rats[id].mapY;
	rats[id].moveCnt=32;
	
	if (dir == 0 && rats[id].mapY>0) { // up
		rats[id].nextMapY--;
		sprRef(rats[id].sprId,2);
		sprFlip(rats[id].sprId,false,false);
	} else if (dir == 1 && rats[id].mapX<31) {// right
		rats[id].nextMapX++;
		sprRef(rats[id].sprId,3);
		sprFlip(rats[id].sprId,false,false);
	} else if (dir == 2 && rats[id].mapY<55) { // down
		rats[id].nextMapY++;
		sprRef(rats[id].sprId,2);
		sprFlip(rats[id].sprId,false,true);
	} else if (dir == 3 && rats[id].mapX>0) { // left
		rats[id].nextMapX--;
		sprRef(rats[id].sprId,3);
		sprFlip(rats[id].sprId,true,false);
	}
	else rats[id].moveCnt=0;
}



void ratsStart() {
	for (byte id=0;id<8;id++)
		mapRemoveRat(id);

	ratsInit();
	if (numRats>=1) 
		ratsSetMapPos(0,13,54,willMove);
	if (numRats>=2) 
		ratsSetMapPos(1,15,54,willMove);
	if (numRats>=3) 
		ratsSetMapPos(2,17,54,willMove);
	if (numRats>=4) 
		ratsSetMapPos(3,11,54,willMove);
	if (numRats>=5) 
		ratsSetMapPos(4,19,54,willMove);
	if (numRats>=6) 
		ratsSetMapPos(5,0,0,willMove);
	if (numRats>=7) 
		ratsSetMapPos(6,31,55,willMove);
	if (numRats>=8) 
		ratsSetMapPos(7,31,0,willMove);	
}

// Determine the direction the rats should take
void _ratsChase(byte id) {
int playerMapX;
int playerMapY;
int x;
int y;
nat a;
nat addr[4];
byte dirFree;
byte dirStart;
byte dir;
byte i;

	if(rats[id].mapX==-1 || !rats[id].willMove || rats[id].moveCnt!=0)
		return;

	playerMapX=_tsTileOffsetX-8;
	playerMapY=_tsTileOffsetY-24;

	x=rats[id].mapX;
	y=rats[id].mapY;

	a=(nat)(_tsMapAddr+(yoffs+y)*64+xoffs+x);

	addr[0]=a-64;
	addr[1]=a+1;
	addr[2]=a+64;
	addr[3]=a-1;

	dirFree=0;

	for(dir=0;dir<4;dir++) {
		// Rats can also run over cats, rocks, etc.
		i=peek(addr[dir],_tsMapPage);
		if(i==0 || i>=22)
			dirFree|=(byte)(1<<dir);
	}

	dirStart=rnd(0,3);

	// First: trying to be closest from the player
	for(i=0;i<4;i++) {
		dir=(dirStart+i)&3;

		if(dir==rats[id].noDir)
			continue;

		if((dirFree&(byte)(1<<dir))==0)
			continue;
		
		if (reverseChase<_time) {
			if((dir==0 && y<=playerMapY) ||
			(dir==1 && x>=playerMapX) ||
			(dir==2 && y>=playerMapY) ||
			(dir==3 && x<=playerMapX))
				continue;
		} else {
			if((dir==0 && y>playerMapY) ||
			(dir==1 && x<playerMapX) ||
			(dir==2 && y<playerMapY) ||
			(dir==3 && x>playerMapX))
				continue;			
		}

		ratsMove(id,dir);
		rats[id].noDir=dir+2;
		if(rats[id].noDir>3)
			rats[id].noDir-=4;
		break;
	}

	if(i<4)
		return;

	// Trying other directions (except going back)
	for(i=0;i<4;i++) {
		dir=(dirStart+i)&3;

		if(dir==rats[id].noDir)
			continue;

		if(dirFree&(byte)(1<<dir)) {
			ratsMove(id,dir);
			rats[id].noDir=dir+2;
			if(rats[id].noDir>3)
				rats[id].noDir-=4;
			break;
		}
	}

	if(i<4)
		return;

	// Go back if possible (should be)
	dir=rats[id].noDir;
	if(dirFree&(byte)(1<<dir)) {
		ratsMove(id,dir);
		rats[id].noDir=dir+2;
		if(rats[id].noDir>3)
			rats[id].noDir-=4;
	}
}


void ratsLoop() {
byte id;

	for(id=0;id<8;id++) {
		if (rats[id].moveCnt>0) {
			
			if(rats[id].moveCnt<15 && rats[id].starRotate<_time && isSprTile(rats[id].sprId,28,false)) {
				rats[id].starRotate=_time+rnd(5,15);
				rats[id].starStep=0;
			}

			if(rats[id].starRotate>_time) {
				if (rats[id].starStep==10) {
					sprRef(rats[id].sprId,2);
					sprFlip(rats[id].sprId,false,false);
				} else if (rats[id].starStep==20) {
					sprRef(rats[id].sprId,3);
					sprFlip(rats[id].sprId,false,false);
				} else if (rats[id].starStep==30) {
					sprRef(rats[id].sprId,2);
					sprFlip(rats[id].sprId,false,true);
				} else if (rats[id].starStep==40) {
					sprRef(rats[id].sprId,3);
					sprFlip(rats[id].sprId,true,false);
				}
				if (rats[id].starStep==40) rats[id].starStep=0;
				else rats[id].starStep++;
				continue;
			}
			
			
			rats[id].moveCnt-=ratSpeed;
			if (rats[id].nextMapX>rats[id].mapX)
				rats[id].X+=ratSpeed;
			else if (rats[id].nextMapX<rats[id].mapX)
				rats[id].X-=ratSpeed;
			else if (rats[id].nextMapY<rats[id].mapY)
				rats[id].Y-=ratSpeed;
			else if (rats[id].nextMapY>rats[id].mapY)
				rats[id].Y+=ratSpeed;
			if (rats[id].moveCnt<=0) {
				rats[id].moveCnt=0;
				rats[id].mapX=rats[id].nextMapX;
				rats[id].mapY=rats[id].nextMapY;
				_ratsChase(id);
			} else continue;
		} else
			_ratsChase(id);
	}
	_ratsDisplay();
}


