	sprFlip(31,false,false);	
}

void _snd_onoff(bool b) {
	if (!b || noMusic) {
		ymNoteOff(0);
		ymNoteOff(1);
		_snd_on=false;
	} else _snd_on=true;

}

void soundBeep(byte typ){
byte n1;
byte n2;
	if (noMusic) return;
	if (typ==0) {
		n1=90;
		n2=97;
	} else if (typ==1) {
		n1=97;
		n2=90;
	} else {
		n1=120;
		n2=100;
	}
	
	_snd_onoff(false);
	synNoteOff(1);
	synVoice(1,1,4,0b11,15); 
	synEnv(1,1,2,0,2);
	synNoteOn(1,n1,120);
	clkSet();
	while(_mSec<70){}
	synNoteOff(1);
	synNoteOn(1,n2,120);
	clkSet();
	while(_mSec<70){}
	synVoice(1,1,5,0b11,10); 
	synEnv(1,0,5,9,15);
	_snd_onoff(true);
}

void soundBeep2(){
	if (noMusic) return;
	_snd_onoff(false);
	synNoteOff(1);
	synVoice(1,1,4,0b11,15); 
	synEnv(1,1,2,0,2);
	synNoteOn(1,90,120);
	clkSet();
	while(_mSec<70){}
	synNoteOff(1);
	synNoteOn(1,97,120);
	clkSet();
	while(_mSec<70){}
	synVoice(1,1,5,0b11,10); 
	synEnv(1,0,5,9,15);
	_snd_onoff(true);
}

void pause() {
	if (_keyDwn == 66) {
		_snd_onoff(false);
		sleep(300);
		while(_keyDwn==0) {}
		_snd_onoff(true);
		sleep(150);
	}
}

